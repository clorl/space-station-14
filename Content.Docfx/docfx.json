{
    "metadata": [
        {
            "src":
            [
                {
                    "files": [
                        "**.csproj"
                    ],
                    "exclude": [
                        "**/bin/**",
                        "**/obj/**",
                        "_site/**",
                        "**.xaml"
                    ],
                    "src": "../Content.Client"
                }
            ],
            "disableGitFeatures": false,
            "disableDefaultFilter": false,
            "dest": "api/Content.Client",
            "namespaceLayout": "nested"
        },
        {
            "src":
            [
                {
                    "files": [
                        "**.csproj"
                    ],
                    "exclude": [
                        "**/bin/**",
                        "**/obj/**",
                        "_site/**",
                        "**.xaml"
                    ],
                    "src": "../Content.Server"
                }
            ],
            "disableGitFeatures": false,
            "disableDefaultFilter": false,
            "dest": "api/Content.Server",
            "namespaceLayout": "nested"
        },
        {
            "src":
            [
                {
                    "files": [
                        "**.csproj"
                    ],
                    "exclude": [
                        "**/bin/**",
                        "**/obj/**",
                        "_site/**",
                        "**.xaml"
                    ],
                    "src": "../Content.Shared"
                }
            ],
            "disableGitFeatures": false,
            "disableDefaultFilter": false,
            "dest": "api/Content.Shared",
            "namespaceLayout": "nested"
        }
    ],
    "build": {
        "content": [
            {
                "files": [
                    "api/**/**.yml"
                ]
            },
            {
                "files": [
                    "articles/**.md",
                    "articles/**/toc.yml",
                    "toc.yml",
                    "*.md"
                ]
            }
        ],
        "resource": [
            {
                "files": [
                    "images/**",
                    "favicon.ico",
                    "icon.svg"
                ]
            }
        ],
        "overwrite": [
            {
                "files": [
                    "apidoc/**.md"
                ],
                "exclude": [
                    "obj/**",
                    "_site/**"
                ]
            }
        ],
        "dest": "_content-site",
        "globalMetadataFiles": [],
        "fileMetadataFiles": [],
        "template": [
            "default-new",
            "modern"
        ],
        "postProcessors": [],
        "markdownEngineName": "markdig",
        "noLangKeyword": false,
        "keepFileLink": false,
        "cleanupCacheHistory": false,
        "disableGitFeatures": false
    }
}
