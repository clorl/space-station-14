{
    "metadata": [
        {
            "src": [
                {
                    "files": ["**.csproj"],
                    "src": "../Content.Client"
                },
                {
                    "files": ["**.csproj"],
                    "src": "../Content.Server"
                },
                {
                    "files": ["**.csproj"],
                    "src": "../Content.Shared"
                }
            ],
            "dest": "api/Components",
            "filter": "filterConfig.yml",
            "namespaceLayout": "nested"
        }
    ],

    "build": {
        "content": [
            {
                "files": [
                    "api/**/**.yml"
                ]
            },
            {
                "files": [
                    "articles/**.md",
                    "articles/**/toc.yml",
                    "toc.yml",
                    "*.md"
                ]
            }
        ],
        "resource": [
            {
                "files": [
                    "images/**",
                    "favicon.ico",
                    "icon.svg"
                ]
            }
        ],
        "overwrite": [
            {
                "files": [
                    "apidoc/**.md"
                ],
                "exclude": [
                    "obj/**",
                    "_site/**"
                ]
            }
        ],
        "dest": "_content-site",
        "template": [
            "spacefx"
        ],

        "exportRawModel": true,
        "rawModelOutputFolder": "logs/raw",
        "exportViewModel": true,
        "viewModelOutputFolder": "logs/view",

        "maxParallelism": 4,
        "disableGitFeatures": true,

        "globalMetadata": {
            "_disableAffix": true
        },
        "fileMetadata": {
            "keywords": {
                "**Component**": ["Component"]
            }
        },

        "postProcessors": [],
        "markdownEngineName": "markdig",
        "noLangKeyword": false,
        "keepFileLink": false,
        "cleanupCacheHistory": false
    }
}
